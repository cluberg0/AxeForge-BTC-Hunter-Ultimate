{
  "openapi": "3.0.3",
  "info": {
    "title": "AxeForge RU-FIX10 ULTIMATE native additions",
    "version": "1.4.10-ru-fix10-ultimate"
  },
  "servers": [
    {
      "url": "http://{miner}",
      "variables": {
        "miner": {
          "default": "192.168.1.50"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-AxeForge"
      },
      "session": {
        "type": "apiKey",
        "in": "header",
        "name": "X-AxeForge-Session"
      }
    }
  },
  "paths": {
    "/api/intelligence": {
      "get": {
        "summary": "Native history, cooling options and measured fallback point",
        "security": [],
        "responses": {
          "200": {
            "description": "Current native state; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "native",
                    "time",
                    "last",
                    "archiveOk",
                    "enabled",
                    "restore",
                    "curve",
                    "stableSamples",
                    "point",
                    "rows"
                  ],
                  "properties": {
                    "native": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "time": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                    },
                    "last": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                    },
                    "archiveOk": {
                      "type": "boolean",
                      "description": "False after allocation, task or flash/archive failure; settings are not erased."
                    },
                    "enabled": {
                      "type": "boolean",
                      "description": "False after allocation, task or flash/archive failure; settings are not erased."
                    },
                    "restore": {
                      "type": "boolean",
                      "description": "False after allocation, task or flash/archive failure; settings are not erased."
                    },
                    "curve": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 50,
                        "maximum": 100
                      },
                      "minItems": 4,
                      "maxItems": 4,
                      "description": "Nondecreasing fan duty at 40/50/60/70 Celsius; only enabled extra floor in stock automatic mode."
                    },
                    "stableSamples": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                    },
                    "point": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                      },
                      "minItems": 5,
                      "maxItems": 5,
                      "description": "[MHz, mV, cap W, measured GH/s, Unix seconds], zero values mean absent; never a guarantee of hardware stability."
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "nullable": true,
                          "oneOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        "minItems": 20,
                        "maxItems": 20,
                        "description": "Positional history row. Missing physical observations are JSON null; reserved positions are null. No interpolation is implied. Time is Unix milliseconds.",
                        "x-columns": [
                          "time_ms",
                          "hashrate_TH_s",
                          "ASIC_C",
                          "VRM_C",
                          "power_W",
                          "efficiency_J_TH",
                          "fan_pct",
                          "frequency_MHz",
                          "set_core_mV",
                          "errors_pct",
                          "BTC_network_difficulty",
                          "reserved",
                          "reserved",
                          "reserved",
                          "fan_RPM",
                          "input_V",
                          "measured_core_mV",
                          "network",
                          "samples",
                          "step_s"
                        ]
                      },
                      "description": "Autonomous 30-second telemetry, RAM/hourly/daily aggregation; recent partial hour can be lost on power cut. Sparse observations stay sparse."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Host, setup-network, or same-origin guard rejected request"
          },
          "500": {
            "description": "Allocation, task, lock or persistent-storage failure"
          }
        },
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                3600,
                86400,
                604800,
                2592000
              ],
              "default": 3600
            },
            "description": "Seconds. Unsupported/malformed values fall back to one hour; storage availability may shorten history."
          }
        ]
      },
      "post": {
        "summary": "Persist optional native controls in af_intel",
        "security": [
          {
            "csrf": [],
            "session": []
          }
        ],
        "description": "X-AxeForge: 1 required. Session only required when 2FA enabled; origin/fetch-site restrictions always apply. No hardware limits or original settings are changed by these endpoints.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "enabled",
                  "restore",
                  "curve"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "False after allocation, task or flash/archive failure; settings are not erased."
                  },
                  "restore": {
                    "type": "boolean",
                    "description": "False after allocation, task or flash/archive failure; settings are not erased."
                  },
                  "curve": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 50,
                      "maximum": 100
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, incomplete body, invalid setting, or unsafe test start"
          },
          "401": {
            "description": "Two-factor session required for POST"
          },
          "403": {
            "description": "Host, setup-network, or same-origin guard rejected request"
          },
          "500": {
            "description": "Allocation, task, lock or persistent-storage failure"
          }
        }
      }
    },
    "/api/hunter": {
      "get": {
        "summary": "Per-request V1 statistics, last block candidate and repeated Benchmark Lab",
        "security": [],
        "responses": {
          "200": {
            "description": "Current native state; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "native",
                    "taskOk",
                    "seconds",
                    "pools",
                    "candidate",
                    "trial",
                    "samplingSeconds"
                  ],
                  "properties": {
                    "native": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "taskOk": {
                      "type": "boolean",
                      "description": "False after allocation, task or flash/archive failure; settings are not erased."
                    },
                    "seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "pools": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "work",
                          "btcWork",
                          "btcAccepted",
                          "accepted",
                          "rejected",
                          "missing",
                          "failed",
                          "cleanN",
                          "cleanMs",
                          "cleanMax",
                          "connectedSeconds",
                          "disconnectedSeconds",
                          "observedSeconds",
                          "unobservedSeconds"
                        ],
                        "properties": {
                          "work": {
                            "type": "number"
                          },
                          "btcWork": {
                            "type": "number"
                          },
                          "btcAccepted": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "accepted": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "rejected": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "missing": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "failed": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "cleanN": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "cleanMs": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "cleanMax": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "connectedSeconds": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "disconnectedSeconds": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "observedSeconds": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "unobservedSeconds": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "description": "V1/TLS ledger since boot; work is sum of originating share difficulty for accepted matched replies. Missing replies are unknown, never accepted. SV2 aggregate acknowledgements are excluded. cleanMs/cleanMax measure notify-to-driver-send completion, not ASIC hashing. Connection durations are sampled every five seconds; unobservedSeconds marks controller gaps."
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "candidate": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "state",
                        "pool",
                        "hash",
                        "persisted"
                      ],
                      "properties": {
                        "state": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 7,
                          "description": "0 none; 1 queued; 2 sent; 3 pool accepted (not Bitcoin confirmation); 4 pool rejected; 5 transport failure; 6 reply unknown; 7 SV2 sent, no individual acknowledgement"
                        },
                        "pool": {
                          "type": "integer",
                          "minimum": -1,
                          "maximum": 3,
                          "description": "Zero-based originating pool; -1 when absent"
                        },
                        "hash": {
                          "type": "string",
                          "pattern": "^([0-9a-fA-F]{64})?$"
                        },
                        "persisted": {
                          "type": "boolean",
                          "description": "False after allocation, task or flash/archive failure; settings are not erased."
                        }
                      }
                    },
                    "trial": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "state",
                        "stage",
                        "elapsed",
                        "rates",
                        "accepted",
                        "rejected",
                        "uncertain",
                        "ci95Low",
                        "ci95High",
                        "phase",
                        "intervalMs",
                        "totalStages",
                        "warmupSeconds",
                        "measurementSeconds",
                        "round",
                        "abortReason",
                        "stageRates",
                        "stageAccepted",
                        "stageRejected",
                        "repeatsCompleted",
                        "autoApply",
                        "confidenceMethod"
                      ],
                      "properties": {
                        "state": {
                          "type": "integer",
                          "enum": [
                            0,
                            1,
                            2,
                            3
                          ],
                          "description": "0 idle, 1 running, 2 complete, 3 stopped"
                        },
                        "stage": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "elapsed": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Seconds in current stage"
                        },
                        "rates": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "accepted": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "rejected": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unix seconds of latest valid wall-clock sample; 0 before first sample."
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "uncertain": {
                          "type": "boolean",
                          "description": "False after allocation, task or flash/archive failure; settings are not erased."
                        },
                        "ci95Low": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "ci95High": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "phase": {
                          "type": "string",
                          "enum": [
                            "idle",
                            "warmup",
                            "measure",
                            "done",
                            "aborted"
                          ]
                        },
                        "intervalMs": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "totalStages": {
                          "type": "integer",
                          "enum": [
                            6
                          ]
                        },
                        "warmupSeconds": {
                          "type": "integer",
                          "enum": [
                            300
                          ]
                        },
                        "measurementSeconds": {
                          "type": "integer",
                          "enum": [
                            1800
                          ]
                        },
                        "round": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2
                        },
                        "abortReason": {
                          "type": "string",
                          "description": "Machine-readable stop cause; none before an abort.",
                          "enum": [
                            "none",
                            "user",
                            "safety_or_telemetry",
                            "pool_changed",
                            "configuration_changed",
                            "temperature_drift",
                            "insufficient_samples",
                            "controller_timeout",
                            "transport_failure",
                            "reply_loss_or_rejections"
                          ]
                        },
                        "stageRates": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 6,
                          "maxItems": 6
                        },
                        "stageAccepted": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 6,
                          "maxItems": 6
                        },
                        "stageRejected": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 6,
                          "maxItems": 6
                        },
                        "repeatsCompleted": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 2
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "autoApply": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        "confidenceMethod": {
                          "type": "string",
                          "enum": [
                            "weighted_poisson_and_two_repeat_spread"
                          ]
                        }
                      },
                      "description": "Benchmark Lab: balanced 500/350/250/250/350/500 ms sequence. Each stage has 300 s warm-up excluded from statistics followed by 1800 s measurement. rates/accepted/rejected/ci95Low/ci95High aggregate intervals [500,350,250]. stage* arrays contain six measurements. Weighted-Poisson uncertainty and two-repeat spread are exploratory, not causal proof. Original interval restored; autoApply is always false."
                    },
                    "samplingSeconds": {
                      "type": "integer",
                      "enum": [
                        5
                      ],
                      "description": "Observation cadence for connected/disconnected estimates; transitions are sampled, not exact wire timestamps"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Host, setup-network, or same-origin guard rejected request"
          },
          "500": {
            "description": "Allocation, task, lock or persistent-storage failure"
          }
        }
      },
      "post": {
        "summary": "Start or cancel the optional repeated timing benchmark",
        "security": [
          {
            "csrf": [],
            "session": []
          }
        ],
        "description": "X-AxeForge: 1 required. Session only required when 2FA enabled; origin/fetch-site restrictions always apply. No hardware limits or original settings are changed by these endpoints. start=true additionally needs 30 minutes of continuous healthy locked capped tuning, one V1/TLS failover pool, default timing/version rolling and sufficient accepted samples during every 1800 s measurement stage after 300 s warm-up; Six balanced stages, two measurements of each interval; start=false cancels without flash writes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "start"
                ],
                "properties": {
                  "start": {
                    "type": "boolean",
                    "description": "False after allocation, task or flash/archive failure; settings are not erased."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, incomplete body, invalid setting, or unsafe test start"
          },
          "401": {
            "description": "Two-factor session required for POST"
          },
          "403": {
            "description": "Host, setup-network, or same-origin guard rejected request"
          },
          "500": {
            "description": "Allocation, task, lock or persistent-storage failure"
          }
        }
      }
    },
    "/api/guardian": {
      "get": {
        "summary": "Optional external observation of the last Bitcoin candidate hash",
        "security": [],
        "responses": {
          "200": {
            "description": "Current native state; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "taskOk": {
                      "type": "boolean"
                    },
                    "state": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5,
                      "description": "0 none, 1 pending, 2 remote HTTP 404, 3 remotely observed, 4 lookup error/expired, 5 disabled"
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^([0-9a-fA-F]{64})?$"
                    },
                    "checked": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Unix seconds of latest attempted HTTPS lookup; 0 before NTP/attempt"
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Reported height; 0 when unknown/off-chain"
                    },
                    "inBestChain": {
                      "type": "boolean",
                      "description": "Meaningful only for state 3, according to external service"
                    },
                    "error": {
                      "type": "string",
                      "description": "Bounded machine-readable code; expired means 24-hour lookup window elapsed"
                    }
                  },
                  "required": [
                    "enabled",
                    "taskOk",
                    "state",
                    "hash",
                    "checked",
                    "height",
                    "inBestChain",
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Host, setup-network, or same-origin guard rejected request"
          },
          "500": {
            "description": "Allocation, task, lock or persistent-storage failure"
          }
        },
        "description": "Off by default. Independent low-priority HTTPS observer of a fixed mempool.space service; only the 64-character block hash is sent. Never delays local submission, never retries a share to another pool, and does not implement own-node consensus validation. A pool ACK is not a chain confirmation; state observed is the remote service response."
      },
      "post": {
        "summary": "Enable or disable the optional external observer",
        "security": [
          {
            "csrf": [],
            "session": []
          }
        ],
        "description": "X-AxeForge: 1 and stock same-origin rules required; OTP session required only when 2FA enabled. Explicitly persists enabled in separate af_guardian namespace; default false. Does not alter miner settings, pools, voltage/frequency or boot partition. Does not require reboot. Unavailable task/NVS/busy returns 500.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, enabled type, body size or incomplete body"
          },
          "401": {
            "description": "Two-factor session required for POST"
          },
          "403": {
            "description": "Host, setup-network, or same-origin guard rejected request"
          },
          "500": {
            "description": "Allocation, task, lock or persistent-storage failure"
          }
        }
      }
    },
    "/api/network": {
      "get": {
        "summary": "Event-driven network diagnostics; no sockets or requests from GET",
        "security": [],
        "responses": {
          "200": {
            "description": "Since first connection attempt per slot. Slot totals can include changed hosts; TCP connectivity does not establish Stratum job readiness. Processing time measures CPU handler latency, not ASIC hashing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "weatherPolling",
                    "mempoolPolling",
                    "version",
                    "utcOffsetMinutes",
                    "activePool",
                    "freeInternal",
                    "minimumInternal",
                    "pools"
                  ],
                  "properties": {
                    "weatherPolling": {
                      "type": "boolean"
                    },
                    "mempoolPolling": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "integer",
                      "enum": [
                        2
                      ]
                    },
                    "utcOffsetMinutes": {
                      "type": "integer",
                      "minimum": -720,
                      "maximum": 840
                    },
                    "activePool": {
                      "type": "integer",
                      "minimum": -1,
                      "maximum": 3
                    },
                    "freeInternal": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minimumInternal": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pools": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "slot",
                          "attempts",
                          "reconnects",
                          "rxBytes",
                          "messages",
                          "connectErrors",
                          "readErrors",
                          "writeErrors",
                          "idleReconnects",
                          "malformedMessages",
                          "tcpConnected",
                          "upSeconds",
                          "downSeconds",
                          "meanProcessingMs",
                          "maxProcessingMs",
                          "lastRxAgeSeconds"
                        ],
                        "properties": {
                          "slot": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "attempts": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "reconnects": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "rxBytes": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "messages": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "connectErrors": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "readErrors": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "writeErrors": {
                            "type": "integer",
                            "minimum": 0
                          },
